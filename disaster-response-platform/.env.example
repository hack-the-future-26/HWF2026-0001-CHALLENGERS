# Copy this file to .env to configure the platform.

# Port the server listens on (default 3000)
PORT=3000

# Set to "true" to use Claude (Anthropic API) for smarter severity
# classification instead of the built-in rule-based engine.
# Requires ANTHROPIC_API_KEY to be set below.
USE_LLM=false

# Your Anthropic API key (only needed if USE_LLM=true)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# REAL EMAIL ALERTS
# ---------------------------------------------------------------------------
# When enabled, a real email is sent to ALERT_TO_EMAIL every time a report
# meets ALERT_MIN_SEVERITY or higher. This is the only way this project
# "reaches a real person" - it does NOT connect to any police/fire/ambulance
# dispatch system (no public API for that exists). The recipient must be a
# real person or team who will actually read the email and respond.
#
# EASIEST FREE SETUP (Gmail):
#   1. Turn on 2-Step Verification on the Gmail account you'll send FROM:
#      https://myaccount.google.com/security
#   2. Create an "App Password": https://myaccount.google.com/apppasswords
#      (choose "Mail" as the app) - copy the 16-character password it gives you.
#   3. Fill in the SMTP_* fields below using that Gmail address + app password.
#   4. Set ALERT_TO_EMAIL to whoever should receive alerts (can be the same
#      Gmail address, a distribution list, or someone else's inbox).
#   5. Set EMAIL_ALERTS_ENABLED=true and restart the server.
#
# Any other SMTP provider (Outlook, SendGrid, your organization's mail
# server, etc.) works too - just fill in its host/port/credentials instead.

EMAIL_ALERTS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
# Minimum severity that triggers an alert: Low | Medium | High | Critical
ALERT_MIN_SEVERITY=High
